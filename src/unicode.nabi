// Unicode property classes by name, and the word test of `\b`.

use pkg::tables::{NAME, NAME_TABLE, RANGES, TABLE_AT, TABLE_LEN, WORD_AT, WORD_LEN};

/// The ranges of table `t`.
const fn table(t: usize) -> List<u32> {
    let at = TABLE_AT[t] as usize;
    let n = TABLE_LEN[t] as usize;
    let out: List<u32> = List::with_capacity(2 * n);
    for i in 2 * at..2 * (at + n) { out.push(RANGES[i]); }
    out
}

const fn table_index(key: str) -> usize | none {
    let lo = 0usize;
    let hi = NAME.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let k = NAME[mid];
        if k < key {
            lo = mid + 1;
        } else if k > key {
            hi = mid;
        } else {
            return NAME_TABLE[mid] as usize;
        }
    }
    none
}

/// Whether `key` names a table, without reading it (`NAME` only, which
/// the compile-time check can afford).
const fn has(key: str) -> bool {
    let lo = 0usize;
    let hi = NAME.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let k = NAME[mid];
        if k < key {
            lo = mid + 1;
        } else if k > key {
            hi = mid;
        } else {
            return true;
        }
    }
    false
}

const fn table_named(key: str) -> List<u32> | none {
    if let t: usize = table_index(key) { table(t) } else { none }
}

/// UAX #44 loose matching: case, spaces, `_` and `-` do not count.
const fn norm(s: str) -> str {
    let b = StrBuf::new();
    for c in s.chars() {
        if c != ' ' && c != '_' && c != '-' { b.push(c.to_ascii_lowercase()); }
    }
    b.to_str()
}

/// The class of `\p{name}` (also `name=value`), or `none`.
pub(pkg) const fn property(name: str) -> List<u32> | none {
    if let (k, v): (str, str) = name.split_once("=") {
        let key = norm(k);
        let val = norm(v);
        if key == "gc" || key == "generalcategory" { return general(val); }
        if key == "sc" || key == "script" || key == "scx" || key == "scriptextensions" {
            return table_named("sc:" + val);
        }
        return none;
    }
    let n = norm(name);
    if let r: List<u32> = general(n) { return r; }
    if let r: List<u32> = table_named("sc:" + n) { return r; }
    if let r: List<u32> = binary(n) { return r; }
    if n.starts_with("is") && n.len() > 2 {
        let m = n[2:];
        if let r: List<u32> = general(m) { return r; }
        if let r: List<u32> = table_named("sc:" + m) { return r; }
        if let r: List<u32> = binary(m) { return r; }
    }
    none
}

/// `property` for the syntax check: some class when `name` names one.
pub(pkg) const fn known(name: str) -> List<u32> | none {
    let any: List<u32> = [0u32, 0x10FFFFu32];
    if let (k, v): (str, str) = name.split_once("=") {
        let key = norm(k);
        let val = norm(v);
        if key == "gc" || key == "generalcategory" { return if known_general(val) { any } else { none }; }
        if key == "sc" || key == "script" || key == "scx" || key == "scriptextensions" {
            return if has("sc:" + val) { any } else { none };
        }
        return none;
    }
    let n = norm(name);
    if known_general(n) || has("sc:" + n) || known_binary(n) { return any; }
    if n.starts_with("is") && n.len() > 2 {
        let m = n[2:];
        if known_general(m) || has("sc:" + m) || known_binary(m) { return any; }
    }
    none
}

const fn known_general(n: str) -> bool { n == "any" || n == "ascii" || n == "assigned" || has("gc:" + n) }

const fn known_binary(n: str) -> bool { n == "word" || has("bp:" + n) }

const fn general(n: str) -> List<u32> | none {
    if n == "any" { return [0u32, 0x10FFFFu32]; }
    if n == "ascii" { return [0u32, 0x7Fu32]; }
    if n == "assigned" { return pkg::class::negate(table_named("gc:cn") ?? []); }
    table_named("gc:" + n)
}

const fn binary(n: str) -> List<u32> | none {
    if n == "word" { return word(); }
    table_named("bp:" + n)
}

/// `\w`: UTS #18 word characters.
pub(pkg) const fn word() -> List<u32> { table_named("perl:word") ?? [] }

/// `\d`: decimal numbers (Nd).
pub(pkg) const fn digit() -> List<u32> { table_named("gc:nd") ?? [] }

/// `\s`: White_Space.
pub(pkg) const fn space() -> List<u32> { table_named("bp:whitespace") ?? [] }

/// Whether `c` is a word character of `\w` (and so of `\b`).
pub(pkg) const fn is_word(c: u32) -> bool {
    if c < 0x80u32 {
        return (c >= 0x30u32 && c <= 0x39u32) || (c >= 0x41u32 && c <= 0x5Au32) || (c >= 0x61u32 && c <= 0x7Au32) || c == 0x5Fu32;
    }
    let lo = WORD_AT;
    let hi = WORD_AT + WORD_LEN;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if c < RANGES[2 * mid] {
            hi = mid;
        } else if c > RANGES[2 * mid + 1] {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}
