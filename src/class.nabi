// Code point sets as flattened, ascending, disjoint (lo, hi) pairs.

use pkg::tables::FOLD;

pub(pkg) const MAX_CP: u32 = 0x10FFFFu32;

/// `pairs` sorted and merged (input pairs may overlap or touch).
pub(pkg) const fn canon(pairs: List<u32>) -> List<u32> {
    let n = pairs.len() / 2;
    if n <= 1 { return pairs; }
    let idx: List<usize> = List::with_capacity(n);
    for i in 0..n { idx.push(i); }
    idx.sort_by_key(|i| pairs[2 * i]);
    let out: List<u32> = List::with_capacity(pairs.len());
    for i in idx {
        let lo = pairs[2 * i];
        let hi = pairs[2 * i + 1];
        let m = out.len();
        if m > 0 && lo <= out[m - 1] + 1u32 {
            if hi > out[m - 1] { out[m - 1] = hi; }
        } else {
            out.push(lo);
            out.push(hi);
        }
    }
    out
}

pub(pkg) const fn union(a: List<u32>, b: List<u32>) -> List<u32> {
    let all: List<u32> = List::with_capacity(a.len() + b.len());
    all.extend(a);
    all.extend(b);
    canon(all)
}

/// The complement within all code points (surrogates included; no
/// `str` holds one, so they never match).
pub(pkg) const fn negate(a: List<u32>) -> List<u32> {
    let out: List<u32> = List::new();
    let next = 0u32;
    let i = 0usize;
    while i < a.len() {
        if a[i] > next {
            out.push(next);
            out.push(a[i] - 1u32);
        }
        next = a[i + 1] + 1u32;
        i += 2;
    }
    if next <= MAX_CP {
        out.push(next);
        out.push(MAX_CP);
    }
    out
}

pub(pkg) const fn intersect(a: List<u32>, b: List<u32>) -> List<u32> {
    let out: List<u32> = List::new();
    let i = 0usize;
    let j = 0usize;
    while i < a.len() && j < b.len() {
        let lo = if a[i] > b[j] { a[i] } else { b[j] };
        let hi = if a[i + 1] < b[j + 1] { a[i + 1] } else { b[j + 1] };
        if lo <= hi {
            out.push(lo);
            out.push(hi);
        }
        if a[i + 1] < b[j + 1] { i += 2; } else { j += 2; }
    }
    out
}

pub(pkg) const fn difference(a: List<u32>, b: List<u32>) -> List<u32> { intersect(a, negate(b)) }

pub(pkg) const fn symmetric(a: List<u32>, b: List<u32>) -> List<u32> { difference(union(a, b), intersect(a, b)) }

pub(pkg) const fn contains(a: List<u32>, c: u32) -> bool {
    let lo = 0usize;
    let hi = a.len() / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if c < a[2 * mid] {
            hi = mid;
        } else if c > a[2 * mid + 1] {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

/// `a` closed under simple case folding: every character that folds
/// like a member is added.
pub(pkg) const fn fold(a: List<u32>) -> List<u32> {
    let extra: List<u32> = List::new();
    let n = FOLD.len() / 2;
    let i = 0usize;
    while i < a.len() {
        let lo = a[i];
        let hi = a[i + 1];
        // first fold entry >= lo
        let l = 0usize;
        let h = n;
        while l < h {
            let m = (l + h) / 2;
            if FOLD[2 * m] < lo { l = m + 1; } else { h = m; }
        }
        let k = l;
        while k < n && FOLD[2 * k] <= hi {
            // walk the orbit
            let c = FOLD[2 * k + 1];
            let steps = 0;
            while c != FOLD[2 * k] && steps < 8 {
                extra.push(c);
                extra.push(c);
                c = next_fold(c);
                steps += 1;
            }
            k += 1;
        }
        i += 2;
    }
    if extra.is_empty() { return a; }
    union(a, extra)
}

/// The next member of `c`'s fold orbit, or `c` itself.
pub(pkg) const fn next_fold(c: u32) -> u32 {
    let l = 0usize;
    let h = FOLD.len() / 2;
    while l < h {
        let m = (l + h) / 2;
        let v = FOLD[2 * m];
        if v < c {
            l = m + 1;
        } else if v > c {
            h = m;
        } else {
            return FOLD[2 * m + 1];
        }
    }
    c
}

/// The fold orbit of one character as a class.
pub(pkg) const fn fold_char(c: u32) -> List<u32> {
    let out: List<u32> = [c, c];
    let d = next_fold(c);
    while d != c {
        out.push(d);
        out.push(d);
        d = next_fold(d);
    }
    canon(out)
}

/// ASCII-only fold, for `(?-u)`.
pub(pkg) const fn fold_ascii(a: List<u32>) -> List<u32> {
    let extra: List<u32> = List::new();
    let up = intersect(a, [0x41u32, 0x5Au32]);
    let lo = intersect(a, [0x61u32, 0x7Au32]);
    let i = 0usize;
    while i < up.len() {
        extra.push(up[i] + 32u32);
        extra.push(up[i + 1] + 32u32);
        i += 2;
    }
    i = 0;
    while i < lo.len() {
        extra.push(lo[i] - 32u32);
        extra.push(lo[i + 1] - 32u32);
        i += 2;
    }
    if extra.is_empty() { a } else { union(a, extra) }
}
